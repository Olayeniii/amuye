# Amúyẹ client agent registered in the Virtuals Service Registry.
ACP_BUYER_WALLET_ADDRESS=0x...
ACP_BUYER_WALLET_ID=...
# Privy base64 PKCS#8 P-256 authorization key, not an EOA private key.
ACP_BUYER_SIGNER_PRIVATE_KEY=MIGH...

# Registered provider wallet and exact risk-synthesis offering name.
ACP_RISK_PROVIDER_ADDRESS=0x...
ACP_RISK_PROVIDER_WALLET_ID=...
ACP_RISK_PROVIDER_SIGNER_PRIVATE_KEY=MIGH...
ACP_RISK_OFFERING_NAME=riskSynthesis

# Optional ACP builder attribution and timeout.
ACP_BUILDER_CODE=
ACP_JOB_TIMEOUT_MS=120000
ACP_RISK_MAX_EXPECTED_SPEND=25
BASE_RPC_URL=https://mainnet.base.org
ACP_SETTLEMENT_BLOCK_LOOKBACK=5000

# Deployment safety. Keep true locally if you need to create paid ACP jobs.
# Set false on the public deployment so direct API calls cannot spend funds.
AMUYE_ALLOW_LIVE_ACP=true

# Optional proof sync. Use the same strong random token locally and on the public backend.
# Local machine: set both URL and token so a completed verified live ACP run is pushed.
# Public backend: set only the token so it can receive the authenticated proof.
AMUYE_PROOF_PUBLISH_URL=https://api.amuye.xyz/api/partner-proof/publish
AMUYE_PROOF_PUBLISH_TOKEN=replace-with-a-long-random-secret
